# Copy to .env. .env is gitignored; this file is not. Never put a real secret here.
# Every row that becomes real also gets a dated row in docs/PINS.md.

# --- hardware (plan 4.1, ADR-0005) ---
# The one flag. laptop = no GPU (the default this curriculum is written against);
# gpu = a resident or rented accelerator; auto = detect (opt-in, never the default).
# Switching to gpu also needs the CUDA torch wheel - see docs/HARDWARE.md. The code
# refuses to run under gpu without it rather than falling back to CPU.
YANTRA_PROFILE=laptop

# --- inference providers (Phases 5+) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- hub & tracking (Phases 2+) ---
HF_TOKEN=
WANDB_API_KEY=

# --- observability (Phases 13+) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=yantra
LOGFIRE_TOKEN=

# --- datastores (Phases 15+) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
ELASTICSEARCH_URL=http://localhost:9200
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- cloud (Phases 8+) ---
AWS_REGION=
AWS_PROFILE=
